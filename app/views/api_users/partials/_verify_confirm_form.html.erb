<div class="dialog" id="api_user_verify">
    <div class="wrapper wrapper__small">
        <div class="paper paper--text__left">
            <div class="paper--header">
                <%= button_tag(class: 'button--close', type: '') do %>
                    <i class="fas fa-times"></i>
                <% end %>
                <h2>
                    <% if @api_user[:verified_at].present? %>
                        <%= t('api_users.show.reverify_confirm_html', name: @api_user[:name]) %>
                    <% else %>
                        <%= t('api_users.show.verify_confirm_html', name: @api_user[:name]) %>
                    <% end %>
                </h2>
            </div>
            <div class="paper--content">
                <%= button_to t(:send), verify_api_user_path(@api_user[:id]), data: { turbo: false }, class: 'button button--primary' %>
            </div>
        </div>
    </div>
</div>

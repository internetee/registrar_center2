<div class="page--block--header">
    <h2><%= t('contacts.show.general') %></h2>
</div>
<table class="table table__basic">
    <tbody>
        <tr>
            <th><%= t('contacts.show.code') %></th>
            <td><%= @contact[:code] %></td>
        </tr>
        <tr>
            <th><%= t('contacts.show.auth_info') %></th>
            <td><%= @contact[:auth_info] %></td>
        </tr>
        <tr>
            <th><%= t('contacts.show.ident') %></th>
            <td><%= ident_for(@contact) %></td>
        </tr>
        <tr>
            <th><%= t('contacts.show.email') %></th>
            <td><%= @contact[:email] %></td>
        </tr>
        <tr>
            <th><%= t('contacts.show.phone') %></th>
            <td><%= @contact[:phone] %></td>
        </tr>
        <tr>
            <th><%= t('contacts.show.verification') %></th>
            <td>
                <%= verification_status_badge(@contact) %>
                <% if @contact[:verified_at].present? %>
                    <div><%= t('contacts.show.verified_on') %> <%= l(@contact[:verified_at].to_datetime, format: :long) %></div>
                    <% if @contact[:verification_id].present? %>
                        <%= icon_link_to 'far fa-file-pdf', download_poi_contact_path(contact_code: @contact[:code]), class: 'simple_tooltip', data: { 'tippy-content': t('contacts.show.download_poi') } %>
                        <%= image_tag "verified_#{I18n.locale}.png", alt: "Verified", class: "verified-image" %>
                    <% end %>
                <% elsif @contact[:verification_pending_at].present? %>
                    <div>
                        <%= t('contacts.show.pending_registrar_review') %>
                        <%= l(@contact[:verification_pending_at].to_datetime, format: :long) %>
                    </div>
                    <% if @contact[:verification_id].present? %>
                        <%= icon_link_to 'far fa-file-pdf', download_poi_contact_path(contact_code: @contact[:code]), class: 'simple_tooltip', data: { 'tippy-content': t('contacts.show.download_poi') } %>
                    <% end %>
                    <div style="display: flex; gap: 8px; align-items: center; margin-top: 8px;">
                        <%= button_to t('contacts.show.approve_verification'), approve_verification_contact_path(contact_code: @contact[:code]), method: :post, class: 'button button--primary small', data: { turbo: false } %>
                        <%= button_to t('contacts.show.reject_verification'), reject_verification_contact_path(contact_code: @contact[:code]), method: :post, class: 'button button--danger small', data: { turbo: false, confirm: t('contacts.show.reject_confirm') } %>
                    </div>
                <% elsif @contact[:ident_request_sent_at].present? %>
                    <div><%= t('contacts.show.ident_requested_on') %> <%= l(@contact[:ident_request_sent_at].to_datetime, format: :long) %></div>
                <% else %>
                    <div><%= t('contacts.show.unverified') %></div>
                <% end %>
            </td>
        </tr>
    </tbody>
</table>
